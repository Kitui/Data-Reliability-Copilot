DRC_ENVIRONMENT=development
DRC_DATABASE_URL=sqlite:///data/drc.db
# PostgreSQL example:
# DRC_DATABASE_URL=postgresql+psycopg://drc:drc@localhost:5432/drc

DRC_STORAGE_BACKEND=local
DRC_STORAGE_ROOT=data
# DRC_GCS_BUCKET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Authentication — set unique values outside development.
DRC_ADMIN_EMAIL=admin@example.invalid
DRC_ADMIN_PASSWORD=replace-with-a-strong-random-password
DRC_ADMIN_NAME=DRC Administrator
DRC_SESSION_HOURS=12
DRC_SECURE_COOKIES=false

# Runtime controls
DRC_RUN_MIGRATIONS=true
DRC_ENABLE_INTERNAL_SCHEDULER=false
# Required for the dedicated /schedules/dispatch endpoint. Use at least 24 random characters.
DRC_SCHEDULER_TOKEN=replace-with-a-long-random-scheduler-token
DRC_MAX_UPLOAD_BYTES=26214400

# Phase 2 security hardening
DRC_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Comma-separated browser origins; leave empty for same-origin only.
DRC_CORS_ORIGINS=
DRC_CSRF_ENABLED=true
DRC_CSRF_COOKIE=drc_csrf
DRC_LOGIN_WINDOW_MINUTES=15
DRC_LOGIN_MAX_ATTEMPTS=5
DRC_LOGIN_LOCKOUT_MINUTES=15
DRC_PASSWORD_MIN_LENGTH=12
DRC_REQUIRE_EMAIL_VERIFICATION=false
# Development only. Never enable in staging or production.
DRC_EXPOSE_DEV_TOKENS=false

# Phase 4 operational reliability
DRC_LOG_LEVEL=INFO
DRC_LOG_FORMAT=json
# Optional protection for /metrics. Send as X-DRC-Metrics-Token.
DRC_METRICS_TOKEN=
DRC_OPS_ERROR_RATE_THRESHOLD=0.10
DRC_OPS_LATENCY_THRESHOLD_MS=2000
DRC_OPS_QUEUE_DEPTH_THRESHOLD=25
DRC_OPS_FAILED_JOB_THRESHOLD=5
DRC_OPS_ALERT_COOLDOWN_MINUTES=30
# Used by scripts/backup_postgres.py
DRC_BACKUP_DIR=backups
